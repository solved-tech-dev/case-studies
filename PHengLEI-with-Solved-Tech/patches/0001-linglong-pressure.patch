diff --git a/CFD/IncomSolver/src/PPEqCalculator.cpp b/CFD/IncomSolver/src/PPEqCalculator.cpp
index d970b52..f66b0d5 100644
--- a/CFD/IncomSolver/src/PPEqCalculator.cpp
+++ b/CFD/IncomSolver/src/PPEqCalculator.cpp
@@ -408,6 +408,36 @@ void PPEqCalculator::solvePPEquation(Grid *gridIn)
 
     CorrectPPEb(grid);
 
+    // Closed domains have a constant pressure nullspace. An optional reference
+    // makes the linear system nonsingular; legacy HYPRE runs leave it disabled.
+    if (GlobalDataBase::IsExist("incomPressureReferenceCell", PHINT, 1))
+    {
+        const int reference = GlobalDataBase::GetIntParaFromDB("incomPressureReferenceCell");
+        if (reference >= 0)
+        {
+            if (PHMPI::GetNumberOfProcessor() != 1 || PHMPI::GetNumberofGlobalZones() != 1
+                || reference >= grid->GetNTotalCell())
+                TK_Exit::ExceptionExit("incomPressureReferenceCell requires one process, one zone and a valid local cell");
+            UnstructBCSet** boundaries = grid->GetBCRecord();
+            for (int face = 0; face < grid->GetNBoundFace(); ++face)
+                if (boundaries[face]->GetKey() == PHENGLEI::OUTFLOW
+                    || boundaries[face]->GetKey() == PHENGLEI::PRESSURE_OUTLET)
+                    TK_Exit::ExceptionExit("incomPressureReferenceCell is only for a closed pressure system without pressure outlets");
+            // p'[reference]=0: eliminate its row and column. The zero prescribed
+            // value needs no RHS update in neighboring rows and retains symmetry.
+            int* left = grid->GetLeftCellOfFace();
+            int* right = grid->GetRightCellOfFace();
+            for (int face = grid->GetNBoundFace(); face < grid->GetNTotalFace(); ++face)
+                if (left[face] == reference || right[face] == reference)
+                {
+                    upperMatrixCoeff[face] = 0;
+                    lowerMatrixCoeff[face] = 0;
+                }
+            diagMatrixCoeff[reference] = 1;
+            bCoeff[reference] = 0;
+        }
+    }
+
     calculateLinearEquation(grid, IDX::S_IP, pc, diagMatrixCoeff, bCoeff, upperMatrixCoeff , lowerMatrixCoeff);
 
     CorrectPPEx(grid);
