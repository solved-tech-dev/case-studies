      "relaxation": 1.0
    },
    "verbosity": 0,
    "coarsesolver": {
      "maxiter": 1,
      "tol": 0.1,
      "solver": "loopsolver",
      "verbosity": 0,
      "preconditioner": {
        "type": "linglongamg",
        "config_file": "examples/configs/linglong-gmres-amg.json",
        "library": "liblinglongamg.so"
      }
    }
  },
  "restart": 15
}
