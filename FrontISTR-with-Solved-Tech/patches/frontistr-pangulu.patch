diff --git a/hecmw1/src/solver/mumps/hecmw_MUMPS_wrapper.F90 b/hecmw1/src/solver/mumps/hecmw_MUMPS_wrapper.F90
index 3473cb8..f275415 100644
--- a/hecmw1/src/solver/mumps/hecmw_MUMPS_wrapper.F90
+++ b/hecmw1/src/solver/mumps/hecmw_MUMPS_wrapper.F90
@@ -30,6 +30,15 @@ contains
 #ifdef HECMW_WITH_MUMPS
     integer(kind=kint) :: ierr,myrank
 
+#ifdef FRONTISTR_WITH_PANGULU
+    character(len=32) :: backend
+    integer :: env_status
+    call get_environment_variable('FRONTISTR_SOLVER', backend, status=env_status)
+    if (env_status == 0 .and. trim(backend) == 'pangulu') then
+      call solve_with_pangulu(spMAT, job, istat)
