+static double ccx_newton_now(void)
+{
+  struct timespec ts;
+  clock_gettime(CLOCK_MONOTONIC,&ts);
+  return (double)ts.tv_sec+1.e-9*(double)ts.tv_nsec;
+}
+
+static void ccx_newton_end(ITG step,ITG increment,ITG attempt,
+                           ITG iteration,double started,ITG icntrl,
+                           ITG icutb)
+{
+  printf(" [CCX_NEWTON_TIMING] step=%" ITGFORMAT
+         " increment=%" ITGFORMAT " attempt=%" ITGFORMAT
+         " iteration=%" ITGFORMAT " seconds=%.9f icntrl=%" ITGFORMAT
+         " icutb=%" ITGFORMAT "\n",step,increment,attempt,iteration,
+         ccx_newton_now()-started,icntrl,icutb);
+  fflush(stdout);
+}
 
